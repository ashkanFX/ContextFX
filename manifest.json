{
  "manifest_version": 3,
  "name": "ContextFX",
  "description": "Capture, track, and analyze new vocabulary while browsing.",
  "version": "0.1.0",
  "icons": { 
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "scripting"
  ],
  "action": {
    "default_popup": "options.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["options.js"],
      "css": ["styles.css"]
    }
  ]
 
}
